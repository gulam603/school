# =============================================================================
#  MT5 FOREX BOT - environment configuration
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real .env file (it is listed in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# TRADING MODE
# -----------------------------------------------------------------------------
# "demo" (default, safe) or "live".
# Live trading additionally requires ALLOW_LIVE_TRADING=true AND
# LIVE_TRADING_CONFIRMATION to be set to the exact phrase below.
TRADING_MODE=demo
ALLOW_LIVE_TRADING=false
# Must be exactly: I UNDERSTAND THE RISK OF LIVE TRADING
LIVE_TRADING_CONFIRMATION=

# -----------------------------------------------------------------------------
# METATRADER 5 TERMINAL
# -----------------------------------------------------------------------------
# Full path to terminal64.exe. Leave empty to auto-detect the installed terminal.
MT5_TERMINAL_PATH=
# Your MT5 DEMO account number (integer). Leave empty to attach to the account
# that is already logged in inside the running terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Milliseconds to wait for the terminal to answer during initialize()
MT5_TIMEOUT_MS=60000
# Enable the terminal's own "Algo Trading" button check before sending orders
MT5_REQUIRE_ALGO_TRADING=true

# -----------------------------------------------------------------------------
# TRADING DEFAULTS
# -----------------------------------------------------------------------------
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=H1
DEFAULT_STRATEGY=ema_crossover
# Comma separated list of the "canonical" symbols the bot may trade.
TRADED_SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,XAUUSD
# Broker suffix/prefix used by your broker, e.g. "m" -> EURUSDm, ".a" -> EURUSD.a
# Leave empty for auto-detection against the broker's Market Watch.
SYMBOL_SUFFIX=
SYMBOL_PREFIX=
# Magic number used to tag every order created by this bot
MAGIC_NUMBER=778899
# Max allowed slippage in points
DEVIATION_POINTS=20
# How often the strategy engine evaluates the market (seconds)
POLL_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# RISK MANAGEMENT (all values are hard limits, enforced server side)
# -----------------------------------------------------------------------------
RISK_PER_TRADE_PERCENT=1.0
MAX_DAILY_LOSS_PERCENT=5.0
MAX_OPEN_TRADES=5
MIN_RISK_REWARD=2.0
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
MAX_LOT_SIZE=1.0
# Leave empty to read the broker's own minimum volume for each symbol
MIN_LOT_SIZE=
MAX_SPREAD_POINTS=30

# -----------------------------------------------------------------------------
# POSITION MANAGEMENT
# -----------------------------------------------------------------------------
BREAK_EVEN_ENABLED=true
BREAK_EVEN_TRIGGER_R=1.0
BREAK_EVEN_OFFSET_POINTS=20
TRAILING_STOP_ENABLED=true
TRAILING_START_R=1.5
TRAILING_DISTANCE_ATR=1.0
PARTIAL_CLOSE_ENABLED=false
PARTIAL_CLOSE_AT_R=1.0
PARTIAL_CLOSE_PERCENT=50
MAX_HOLDING_HOURS=48

# -----------------------------------------------------------------------------
# STRATEGY PARAMETERS (EMA crossover)
# -----------------------------------------------------------------------------
EMA_FAST=20
EMA_SLOW=50
USE_RSI_FILTER=true
RSI_PERIOD=14
RSI_BUY_MAX=70
RSI_SELL_MIN=30

# -----------------------------------------------------------------------------
# NOTIFICATIONS (optional)
# -----------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma separated list of allowed browser origins for the local dashboard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
DATABASE_PATH=data/mt5_bot.db
